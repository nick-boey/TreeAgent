<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>2cfc6c57-72da-4b56-944b-08f2c1df76f6</UserSecretsId>
        <RootNamespace>Homespun</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Homespun.Tests" />
        <InternalsVisibleTo Include="Homespun.Api.Tests" />
        <!-- Lets Moq/Castle generate proxies for internal interfaces in tests. -->
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="A2A" Version="0.3.3-preview" />
        <PackageReference Include="Anthropic" Version="12.16.0" />
        <PackageReference Include="Fleece.Core" Version="3.1.0" />
        <PackageReference Include="Google.Protobuf" Version="3.28.*" />
        <PackageReference Include="Grpc.Tools" Version="2.68.*">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Markdig" Version="0.44.0" />
        <PackageReference Include="Microsoft.Agents.AI.Hosting.AGUI.AspNetCore" Version="1.0.0-preview.260219.1" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.1" />
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.1" />
        <PackageReference Include="Octokit" Version="14.0.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.0" />
        <PackageReference Include="YamlDotNet" Version="16.2.1" />
    </ItemGroup>

    <ItemGroup>
        <Protobuf Include="..\..\proto\**\*.proto" GrpcServices="None" ProtoRoot="..\..\proto\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Homespun.ServiceDefaults\Homespun.ServiceDefaults.csproj" />
        <ProjectReference Include="..\Homespun.Shared\Homespun.Shared.csproj" />
        <ProjectReference Include="..\Homespun.ServiceDefaults\Homespun.ServiceDefaults.csproj" />
    </ItemGroup>

</Project>
